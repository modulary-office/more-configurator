{
 "id": "cabinet-sliding",
 "name": "ארון דלתות הזזה",
 "family": "cabinet",
 "codePrefix": "MCS",
 "subtitle": "ארון עם דלתות הזזה על מסילות. מעל 160 ס״מ גובה – 4 דלתות בשתי קומות.",
 "note": "הגוונים במסך להמחשה. נשמח לשלוח דוגמאות פיזיות של הגימורים.",
 "model": {
  "kind": "cabinet",
  "front": {
   "t": "sliding",
   "rows": "auto"
  }
 },
 "defaults": {
  "w": 120,
  "h": 90,
  "d": 40,
  "body": "white",
  "face": "oak",
  "base": "none",
  "rails": "plastic",
  "lock": false,
  "back": false
 },
 "sections": [
  {
   "id": "size",
   "title": "מידות",
   "controls": [
    {
     "type": "seg",
     "key": "w",
     "label": "רוחב",
     "num": true,
     "options": [
      {
       "v": 120
      }
     ],
     "custom": {
      "label": "אחר",
      "step": 1,
      "unit": "ס״מ",
      "min": 80,
      "max": 240,
      "inputLabel": "רוחב בס״מ"
     }
    },
    {
     "type": "seg",
     "key": "h",
     "label": "גובה",
     "num": true,
     "options": [
      {
       "v": 90
      },
      {
       "v": 130
      },
      {
       "v": 210
      },
      {
       "v": 240
      }
     ],
     "custom": {
      "label": "אחר",
      "step": 1,
      "unit": "ס״מ",
      "min": 70,
      "max": 260,
      "inputLabel": "גובה בס״מ"
     }
    },
    {
     "type": "seg",
     "key": "d",
     "label": "עומק",
     "num": true,
     "options": [
      {
       "v": 40
      },
      {
       "v": 50
      },
      {
       "v": 60
      }
     ],
     "custom": {
      "label": "אחר",
      "step": 1,
      "unit": "ס״מ",
      "min": 30,
      "max": 60,
      "inputLabel": "עומק בס״מ"
     }
    }
   ]
  },
  {
   "id": "fronts",
   "title": "מסילות",
   "controls": [
    {
     "type": "seg",
     "key": "rails",
     "label": "סוג מסילה",
     "options": [
      {
       "v": "plastic",
       "label": "פלסטיק"
      },
      {
       "v": "alu",
       "label": "אלומיניום"
      }
     ]
    }
   ]
  },
  {
   "id": "finish",
   "title": "גימור",
   "controls": [
    {
     "type": "swatch",
     "key": "body",
     "label": "גוף",
     "catalog": "decors",
     "style": "decor",
     "out": "{he}"
    },
    {
     "type": "swatch",
     "key": "face",
     "label": "חזיתות",
     "catalog": "decors",
     "style": "decor",
     "out": "{he}"
    }
   ]
  },
  {
   "id": "extra",
   "title": "תוספות",
   "controls": [
    {
     "type": "seg",
     "key": "base",
     "label": "בסיס",
     "options": [
      {
       "v": "none",
       "label": "ללא"
      },
      {
       "v": "plinth",
       "label": "צוקל"
      }
     ]
    },
    {
     "type": "toggle",
     "key": "lock",
     "title": "מנעול לחיצה",
     "sub": "לכל דלת"
    },
    {
     "type": "toggle",
     "key": "back",
     "title": "גב מלא",
     "sub": ""
    }
   ]
  }
 ],
 "pricing": {
  "_help": "סכומים לפי מחירון הספק, לפני מע״מ. markup = אחוז רווח על המחירון, vat = מע״מ. ראו README.",
  "source": "מחירון Modulartech (ריהוט משרדי), עמודים 22–49",
  "currency": "₪",
  "label": "מחיר",
  "note": "כולל מע״מ, לא כולל הובלה והרכבה",
  "markup": 100,
  "vat": 18,
  "roundTo": 10,
  "rules": [
   {
    "type": "table",
    "label": "ארון לפי מידה",
    "dims": [
     "w",
     "h"
    ],
    "rows": [
     {
      "w": 120,
      "h": 90,
      "price": 550
     },
     {
      "w": 120,
      "h": 130,
      "price": 680
     },
     {
      "w": 120,
      "h": 210,
      "price": 1180
     },
     {
      "w": 120,
      "h": 240,
      "price": 1050
     }
    ]
   },
   {
    "type": "tiers",
    "label": "תוספת עומק",
    "by": "d",
    "tiers": [
     {
      "upTo": 40,
      "percent": 0
     },
     {
      "upTo": 50,
      "percent": 25
     },
     {
      "upTo": 60,
      "percent": 35
     }
    ]
   },
   {
    "type": "unit",
    "label": "מנעול לחיצה",
    "per": "slideDoors",
    "amount": 25,
    "when": {
     "lock": true
    }
   },
   {
    "type": "unit",
    "label": "גב מלא",
    "per": "per120",
    "amount": 90,
    "when": {
     "back": true
    }
   },
   {
    "type": "unit",
    "label": "צוקל",
    "per": "per120",
    "amount": 55,
    "when": {
     "base": "plinth"
    }
   },
   {
    "type": "option",
    "label": "מסילות אלומיניום",
    "key": "rails",
    "amounts": {
     "plastic": 0,
     "alu": 120
    }
   },
   {
    "type": "customSize",
    "label": "תוספת מידה מיוחדת",
    "keys": [
     "w",
     "h",
     "d"
    ],
    "percent": 0
   }
  ]
 }
}