      "id": "size",
      "title": "מידות",
      "controls": [
        {
          "type": "seg",
          "key": "h",
          "label": "גובה",
          "num": true,
          "options": [
            {
              "v": 77,
              "label": "77 · 2 קומות"
            },
            {
              "v": 110,
              "label": "110 · 3 קומות"
            },
            {
              "v": 145,
              "label": "145 · 4 קומות"
            }
          ],
          "custom": {
            "label": "אחר",
            "step": 1,
            "unit": "ס״מ",
            "min": 60,
            "max": 180,
            "inputLabel": "גובה בס״מ"
          }
        },
        {
          "type": "seg",
          "key": "w",
          "label": "רוחב",
          "num": true,
          "options": [
            {
              "v": 50
            }
          ],
          "custom": {
            "label": "אחר",
            "step": 1,
            "unit": "ס״מ",
            "min": 40,
            "max": 80,
            "inputLabel": "רוחב בס״מ"
          }
        },
        {
          "type": "seg",
          "key": "d",
          "label": "עומק",
          "num": true,
          "options": [
            {
              "v": 45
            }
          ],
          "custom": {
            "label": "אחר",
            "step": 1,
            "unit": "ס״מ",
            "min": 40,
            "max": 60,
            "inputLabel": "עומק בס״מ"
          }
        }
      ]
    },
    {
      "id": "fronts",
      "title": "מגירות",
      "controls": [
        {
          "type": "seg",
          "key": "handle",
          "label": "ידיות",
          "options": [
            {
              "v": "bar",
              "label": "ידית מוט"
            },
            {
              "v": "integral",
              "label": "פרופיל אינטגרלי"
            },
            {
              "v": "none",
              "label": "ללא (לחיצה)"
            }
          ]
        }
      ]
    },
    {
      "id": "finish",
      "title": "גימור",
      "controls": [
        {
          "type": "swatch",
          "key": "body",
          "label": "גוף",
          "catalog": "decors",
          "style": "decor",
          "out": "{he}"
        },
        {
          "type": "swatch",
          "key": "face",
          "label": "חזיתות",
          "catalog": "decors",
          "style": "decor",
          "out": "{he}"
        }
      ]
    },
    {
      "id": "extra",
      "title": "תוספות",
      "controls": [
        {
          "type": "seg",
          "key": "base",
          "label": "בסיס",
          "options": [
            {
              "v": "none",
              "label": "ללא"
            },
            {
              "v": "plinth",
              "label": "צוקל"
            }
          ]
        },
        {
          "type": "toggle",
          "key": "dtc",
          "title": "מסילות שליפה כפולה DTC",
          "sub": "לכל מגירה"
        },
        {
          "type": "toggle",
          "key": "lock",
          "title": "נעילה",
          "sub": "לכל מגירה"
        },
        {
          "type": "toggle",
          "key": "back",
          "title": "גב מלמין",
          "sub": ""
        }
      ]
    }
  ],
  "pricing": {
    "_help": "סכומים לפי מחירון הספק, לפני מע״מ. markup = אחוז רווח על המחירון, vat = מע״מ. ראו README.",
    "source": "מחירון Modulartech (ריהוט משרדי), עמודים 22–49",
    "currency": "₪",
    "label": "מחיר",
    "note": "כולל מע״מ, לא כולל הובלה והרכבה",
    "markup": 100,
    "vat": 18,
    "roundTo": 10,
    "customQuote": true,
    "rules": [
      {
        "type": "table",
        "label": "ארון לפי מידה",
        "dims": [
          "w",
          "h"
        ],
        "rows": [
          {
            "w": 50,
            "h": 77,
            "price": 440
          },
          {
            "w": 50,
            "h": 110,
            "price": 555
          },
          {
            "w": 50,
            "h": 145,
            "price": 700
          }
        ]
      },
      {
        "type": "unit",
        "label": "מסילות DTC",
        "per": "drawers",
        "amount": 100,
        "when": {
          "dtc": true
        }
      },
      {
        "type": "unit",
        "label": "נעילה",
        "per": "drawers",
        "amount": 25,
        "when": {
          "lock": true
        }
      },
      {
        "type": "fixed",
        "label": "גב מלמין",
        "amount": 90,
        "when": {
          "back": true
        }
      },
      {
        "type": "fixed",
        "label": "צוקל",
        "amount": 30,
        "when": {
          "base": "plinth"
        }
      }
    ]
  }
