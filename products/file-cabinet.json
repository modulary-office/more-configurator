{
  "id": "file-cabinet",
  "name": "ארון תיקיות",
  "family": "cabinet",
  "codePrefix": "MCF",
  "subtitle": "ארון תיקיות תלויות סופר פייל, כולל מסילות. 2, 3 או 4 קומות.",
  "note": "הגוונים במסך להמחשה. נשמח לשלוח דוגמאות פיזיות של הגימורים.",
  "model": {
    "kind": "cabinet",
    "front": {
      "t": "files"
    }
  },
  "defaults": {
    "w": 50,
    "d": 45,
    "h": 110,
    "body": "m8700",
    "face": "m8700",
    "handle": "bar",
    "base": "none",
    "dtc": false,
    "lock": false,
    "back": false
  },
  "sections": [
