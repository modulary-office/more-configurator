{
  "id": "shelf-open",
  "name": "כוננית",
  "family": "cabinet",
  "codePrefix": "MCB",
  "subtitle": "כוננית מדפים פתוחה, עם או בלי דלתות תחתונות ודלתות זכוכית.",
  "note": "הגוונים במסך להמחשה. נשמח לשלוח דוגמאות פיזיות של הגימורים.",
  "model": {
    "kind": "cabinet",
    "fronts": {
      "open": {
        "t": "open"
      },
      "openDoors": {
        "t": "openDoors",
        "doorH": 80
      }
    }
  },
  "defaults": {
    "w": 80,
    "h": 210,
    "d": 40,
    "front": "openDoors",
    "body": "m8170",
    "face": "m5172",
    "handle": "bar",
    "glass": "none",
    "base": "none",
    "lock": false,
    "back": false,
    "side28": false,
    "shelves": 0
  },
  "sections": [
    {
      "id": "size",
      "title": "מידות",
      "controls": [
        {
          "type": "seg",
          "key": "w",
          "label": "רוחב",
          "num": true,
          "options": [
            {
              "v": 80
            }
          ],
          "custom": {
            "label": "אחר",
            "step": 1,
            "unit": "ס״מ",
            "min": 40,
            "max": 160,
            "inputLabel": "רוחב בס״מ"
          }
        },
        {
          "type": "seg",
          "key": "h",
          "label": "גובה",
          "num": true,
          "options": [
            {
              "v": 210
            },
            {
              "v": 240
            }
          ],
          "custom": {
            "label": "אחר",
            "step": 1,
            "unit": "ס״מ",
            "min": 80,
            "max": 260,
            "inputLabel": "גובה בס״מ"
          }
        },
        {
          "type": "seg",
          "key": "d",
          "label": "עומק",
          "num": true,
          "options": [
            {
              "v": 30
            },
            {
              "v": 40
            }
          ],
          "custom": {
            "label": "אחר",
            "step": 1,
            "unit": "ס״מ",
            "min": 25,
            "max": 60,
            "inputLabel": "עומק בס״מ"
          }
        }
      ]
    },
    {
      "id": "fronts",
      "title": "חזיתות",
      "controls": [
        {
          "type": "seg",
          "key": "front",
          "label": "סוג",
          "options": [
            {
              "v": "open",
              "label": "מדפים פתוחים"
            },
            {
              "v": "openDoors",
              "label": "פתוחה + דלתות תחתונות"
            }
          ]
        },
        {
          "type": "seg",
          "key": "glass",
          "label": "דלתות זכוכית (גובה 120)",
          "options": [
            {
              "v": "none",
              "label": "ללא"
            },
            {
              "v": "clear",
              "label": "זכוכית"
            },
            {
              "v": "tempered",
              "label": "מחוסמת"
            }
          ],
          "showWhen": {
            "front": "openDoors"
          }
        },
        {
          "type": "seg",
          "key": "handle",
          "label": "ידיות",
          "options": [
            {
              "v": "bar",
              "label": "ידית מוט"
            },
            {
              "v": "integral",
              "label": "פרופיל אינטגרלי"
            },
            {
              "v": "none",
              "label": "ללא (לחיצה)"
            }
          ],
          "showWhen": {
            "front": "openDoors"
          }
        }
      ]
    },
    {
      "id": "finish",
      "title": "גימור",
      "controls": [
        {
          "type": "swatch",
          "key": "body",
          "label": "גוף",
          "catalog": "decors",
          "style": "decor",
          "out": "{he}"
        },
        {
          "type": "swatch",
          "key": "face",
          "label": "חזיתות",
          "catalog": "decors",
          "style": "decor",
          "out": "{he}"
        }
      ]
    },
    {
      "id": "extra",
      "title": "תוספות",
      "controls": [
        {
          "type": "seg",
          "key": "base",
          "label": "בסיס",
          "options": [
            {
              "v": "none",
              "label": "ללא"
            },
            {
              "v": "plinth",
              "label": "צוקל"
            }
          ]
        },
        {
          "type": "stepper",
          "key": "shelves",
          "label": "מדפים נוספים",
          "min": 0,
          "max": 6
        },
        {
          "type": "toggle",
          "key": "lock",
          "title": "מנעול",
          "sub": "לכל זוג דלתות",
          "showWhen": {
            "front": "openDoors"
          }
        },
        {
          "type": "toggle",
          "key": "back",
          "title": "גב מלא",
          "sub": ""
        },
        {
          "type": "toggle",
          "key": "side28",
          "title": "דפנות 28 מ״מ",
          "sub": ""
        }
      ]
    }
  ],
  "pricing": {
    "_help": "סכומים לפי מחירון הספק, לפני מע״מ. markup = אחוז רווח על המחירון, vat = מע״מ. ראו README.",
    "source": "מחירון Modulartech (ריהוט משרדי), עמודים 22–49",
    "currency": "₪",
    "label": "מחיר",
    "note": "כולל מע״מ, לא כולל הובלה והרכבה",
    "markup": 100,
    "vat": 18,
    "roundTo": 10,
    "customQuote": true,
    "rules": [
      {
        "type": "table",
        "label": "כוננית לפי מידה",
        "dims": [
          "w",
          "d",
          "h"
        ],
        "clamp": {
          "d": [
            30,
            40
          ]
        },
        "rows": [
          {
            "w": 80,
            "d": 30,
            "h": 210,
            "price": 360,
            "when": {
              "front": "open"
            }
          },
          {
            "w": 80,
            "d": 30,
            "h": 240,
            "price": 440,
            "when": {
              "front": "open"
            }
          },
          {
            "w": 80,
            "d": 40,
            "h": 210,
            "price": 440,
            "when": {
              "front": "open"
            }
          },
          {
            "w": 80,
            "d": 40,
            "h": 240,
            "price": 510,
            "when": {
              "front": "open"
            }
          },
          {
            "w": 80,
            "d": 30,
            "h": 210,
            "price": 480,
            "when": {
              "front": "openDoors"
            }
          },
          {
            "w": 80,
            "d": 30,
            "h": 240,
            "price": 560,
            "when": {
              "front": "openDoors"
            }
          },
          {
            "w": 80,
            "d": 40,
            "h": 210,
            "price": 560,
            "when": {
              "front": "openDoors"
            }
          },
          {
            "w": 80,
            "d": 40,
            "h": 240,
            "price": 640,
            "when": {
              "front": "openDoors"
            }
          }
        ]
      },
      {
        "type": "tiers",
        "label": "תוספת עומק",
        "by": "d",
        "tiers": [
          {
            "upTo": 40,
            "percent": 0
          },
          {
            "upTo": 50,
            "percent": 25
          },
          {
            "upTo": 60,
            "percent": 35
          }
        ]
      },
      {
        "type": "option",
        "label": "דלתות זכוכית",
        "key": "glass",
        "per": "per80",
        "amounts": {
          "none": 0,
          "clear": 300,
          "tempered": 400
        },
        "when": {
          "front": "openDoors"
        }
      },
      {
        "type": "unit",
        "label": "מנעול",
        "per": "doorPairs",
        "amount": 25,
        "when": {
          "lock": true,
          "front": "openDoors"
        }
      },
      {
        "type": "unit",
        "label": "גב מלא",
        "per": "per80",
        "amount": 120,
        "when": {
          "back": true
        }
      },
      {
        "type": "fixed",
        "label": "דפנות 28 מ״מ",
        "amount": 200,
        "when": {
          "side28": true
        }
      },
      {
        "type": "unit",
        "label": "מדפים נוספים",
        "per": "shelves",
        "amount": 25
      },
      {
        "type": "unit",
        "label": "צוקל",
        "per": "per80",
        "amount": 30,
        "when": {
          "base": "plinth"
        }
      }
    ]
  }
}