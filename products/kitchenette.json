            {
              "v": "left",
              "label": "שמאל"
            }
          ],
          "showWhen": {
            "upper": true
          }
        }
      ]
    },
    {
      "id": "fronts",
      "title": "חזיתות",
      "controls": [
        {
          "type": "seg",
          "key": "finish",
          "label": "גימור חזיתות",
          "options": [
            {
              "v": "formica",
              "label": "סנדוויץ׳ + פורמיקה"
            },
            {
              "v": "epoxy",
              "label": "צבע אפוקסי + ידיות אינטגרליות"
            }
          ],
          "layout": "list"
        },
        {
          "type": "seg",
          "key": "handle",
          "label": "ידיות",
          "options": [
            {
              "v": "bar",
              "label": "ידית מוט"
            },
            {
              "v": "integral",
              "label": "פרופיל אינטגרלי"
            },
            {
              "v": "none",
              "label": "ללא (לחיצה)"
            }
          ],
          "showWhen": {
            "finish": "formica"
          }
        }
      ]
    },
    {
      "id": "finish",
      "title": "צבעים",
      "controls": [
        {
          "type": "swatch",
          "key": "body",
          "label": "משטח וגוף",
          "catalog": "decors",
          "style": "decor",
          "out": "{he}"
        },
        {
          "type": "swatch",
          "key": "face",
          "label": "חזיתות",
          "catalog": "decors",
          "style": "decor",
          "out": "{he}",
          "showWhen": {
            "finish": "formica"
          }
        },
        {
          "type": "swatch",
          "key": "ral",
          "label": "צבע חזיתות לפי RAL",
          "catalog": "ral",
          "style": "ral",
          "out": "RAL {id} · {he}",
          "showWhen": {
            "finish": "epoxy"
          }
        }
      ]
    },
    {
      "id": "extra",
      "title": "תוספות",
      "controls": [
        {
          "type": "seg",
          "key": "flap",
          "label": "מנגנון קלפה",
          "options": [
            {
              "v": "dtc",
              "label": "DTC"
            },
            {
              "v": "hk",
              "label": "DTC HK"
            },
            {
              "v": "micro",
              "label": "מיקרו"
            }
          ],
          "showWhen": {
            "upper": true
          }
        },
        {
          "type": "seg",
          "key": "base",
          "label": "בסיס",
          "options": [
            {
              "v": "plinth",
              "label": "4 רגליים + צוקל"
            },
            {
              "v": "none",
              "label": "ללא"
            }
          ]
        },
        {
          "type": "toggle",
          "key": "dtc",
          "title": "מגירות שליפה כפולה DTC",
          "sub": "לכל מגירה"
        },
        {
          "type": "toggle",
          "key": "softclose",
          "title": "טריקה שקטה למגירות",
          "sub": "דפנות מתכת DTC"
        },
        {
          "type": "toggle",
          "key": "stone",
          "title": "משטח שיש",
          "sub": "במקום משטח פורמיקה, בגוון לבחירה"
        },
        {
          "type": "swatch",
          "key": "stoneColor",
          "label": "גוון השיש",
          "catalog": "stone",
          "style": "swatch",
          "out": "{he}",
          "showWhen": {
            "stone": true
          }
        },
        {
          "type": "toggle",
          "key": "sink",
          "title": "כיור",
          "sub": "מותקן במרכז המשטח"
        },
        {
          "type": "toggle",
          "key": "faucet",
          "title": "ברז",
          "sub": "מעל הכיור"
        }
      ]
    }
