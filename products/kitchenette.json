  "pricing": {
    "_help": "סכומים לפי מחירון הספק, לפני מע״מ. markup = אחוז רווח על המחירון, vat = מע״מ. ראו README.",
    "source": "מחירון Modulartech (ריהוט משרדי), עמודים 22–49",
    "currency": "₪",
    "label": "מחיר",
    "note": "כולל מע״מ, לא כולל הובלה והרכבה",
    "markup": 100,
    "vat": 18,
    "roundTo": 10,
    "customQuote": false,
    "rules": [
      {
        "type": "unit",
        "label": "תחתון סנדוויץ׳ + פורמיקה למטר",
        "per": "lengthM",
        "amount": 900,
        "when": {
          "finish": "formica"
        }
      },
      {
        "type": "unit",
        "label": "תחתון צבע אפוקסי למטר",
        "per": "lengthM",
        "amount": 1500,
        "when": {
          "finish": "epoxy"
        }
      },
      {
        "type": "unit",
        "label": "עליון קלפה DTC למטר",
        "per": "upperLengthM",
        "amount": 900,
        "when": {
          "upper": true
        }
      },
      {
        "type": "option",
        "label": "מתקן קלפה",
        "key": "flap",
        "per": "upperUnits",
        "amounts": {
          "dtc": 0,
          "hk": 220,
          "micro": 250
        },
        "when": {
          "upper": true
        }
      },
      {
        "type": "unit",
        "label": "רגליים וצוקל למטר",
        "per": "lengthM",
        "amount": 75,
        "when": {
          "base": "plinth"
        }
      },
      {
        "type": "unit",
        "label": "מגירות DTC",
        "per": "drawers",
        "amount": 100,
        "when": {
          "dtc": true
        }
      },
      {
        "type": "unit",
        "label": "טריקה שקטה",
        "per": "drawers",
        "amount": 200,
        "when": {
          "softclose": true
        }
      },
      {
        "type": "unit",
        "label": "משטח שיש למטר",
        "per": "lengthM",
        "amount": 800,
        "when": {
          "stone": true
        },
        "final": true
      },
      {
        "type": "fixed",
        "label": "כיור",
        "amount": 1000,
        "when": {
          "sink": true
        },
        "final": true
      },
      {
        "type": "fixed",
        "label": "ברז",
        "amount": 450,
        "when": {
          "faucet": true
        },
        "final": true
      }
    ]
  }
}