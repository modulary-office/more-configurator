{
  "id": "kitchenette",
  "name": "מטבחון",
  "family": "cabinet",
  "codePrefix": "MCM",
  "subtitle": "מטבחון משרדי לפי מטר רץ: ארונות תחתונים עם משטח, ואפשרות לארון עליון עם קלפה באורך שתבחרו, משטח שיש, כיור וברז.",
  "note": "הגוונים במסך להמחשה. נשמח לשלוח דוגמאות פיזיות של הגימורים.",
  "model": {
    "kind": "kitchen",
    "h": 90,
    "d": 60,
    "variantKey": "finish",
    "hero": {
      "th": 0.5,
      "ph": 1.25
    }
  },
  "defaults": {
    "w": 240,
    "finish": "formica",
    "body": "m3161",
    "face": "m7101",
    "ral": "9016",
    "handle": "integral",
    "upper": true,
    "flap": "dtc",
    "base": "plinth",
    "dtc": false,
    "softclose": false,
    "uw": 0,
    "sink": false,
    "faucet": false,
    "stone": false,
    "upos": "center",
    "stoneColor": "2141"
