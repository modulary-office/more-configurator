              "v": 160,
              "label": "160"
            },
            {
              "v": 180,
              "label": "180"
            },
            {
              "v": 240,
              "label": "240"
            }
          ],
          "custom": {
            "label": "אחר",
            "min": 80,
            "max": 400,
            "step": 1,
            "unit": "ס״מ",
            "inputLabel": "אורך הארון העליון בס״מ"
          },
          "showWhen": {
            "upper": true
          }
        },
        {
          "type": "seg",
          "key": "upos",
          "label": "מיקום הארון העליון",
          "options": [
            {
              "v": "right",
              "label": "ימין"
